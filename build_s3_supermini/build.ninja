build esp-idf/loader/libloader.a: C_STATIC_LIBRARY_LINKER____idf_loader_ esp-idf/loader/CMakeFiles/__idf_loader.dir/loader.c.obj esp-idf/loader/CMakeFiles/__idf_loader.dir/loader_menu.c.obj esp-idf/loader/CMakeFiles/__idf_loader.dir/loader_applications.c.obj esp-idf/loader/CMakeFiles/__idf_loader.dir/apps/about_app.c.obj || esp-idf/rpc/librpc.a
