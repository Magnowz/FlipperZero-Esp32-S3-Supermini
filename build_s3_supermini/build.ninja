  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\efuse" && C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe -E echo "
  DESC = Warning: command "show_efuse_table" is deprecated. Have you wanted to run "show-efuse-table" instead?


