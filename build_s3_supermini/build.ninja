  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\efuse" && C:\Espressif\python_env\idf5.4_py3.14_env\Scripts\python.exe C:/Espressif/frameworks/esp-idf-v5.4.1/components/efuse/efuse_table_gen.py C:/Espressif/frameworks/esp-idf-v5.4.1/components/efuse/test/esp_efuse_test_table.csv -t esp32s3 --max_blk_len 256"

