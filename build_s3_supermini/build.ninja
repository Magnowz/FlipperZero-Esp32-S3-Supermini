  restat = 1

build esp-idf/archive/edit_cache: phony esp-idf/archive/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/archive/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\archive" && C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -S"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini" -B"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini""
