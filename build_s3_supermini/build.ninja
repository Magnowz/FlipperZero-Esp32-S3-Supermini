# =============================================================================
# Link build statements for STATIC_LIBRARY target __idf_assets


#############################################
# Link the static library esp-idf\assets\libassets.a

build esp-idf/assets/libassets.a: C_STATIC_LIBRARY_LINKER____idf_assets_ esp-idf/assets/CMakeFiles/__idf_assets.dir/assets_icons.c.obj || esp-idf/gui/libgui.a
  LANGUAGE_COMPILE_FLAGS = -mlongcalls  -fno-builtin-memcpy -fno-builtin-memset -fno-builtin-bzero -fno-builtin-stpcpy -fno-builtin-strncpy
  OBJECT_DIR = esp-idf\assets\CMakeFiles\__idf_assets.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = esp-idf\assets\libassets.a
  TARGET_PDB = assets.a.dbg


#############################################
# Utility command for edit_cache

build esp-idf/assets/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\assets" && C:\Espressif\tools\cmake\3.30.2\bin\cmake-gui.exe -S"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini" -B"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini""
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/assets/edit_cache: phony esp-idf/assets/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/assets/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\assets" && C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -S"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini" -B"G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/assets/rebuild_cache: phony esp-idf/assets/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/assets/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/assets/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/assets/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "G:\Projetos Esp32\FlipperZero-Esp32-S3-Supermini\build_s3_supermini\esp-idf\assets" && C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/assets/install: phony esp-idf/assets/CMakeFiles/install.util


#############################################
# Utility command for install/local

